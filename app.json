{
  "expo": {
    "name": "VOCALink-Mobile",
    "slug": "VOCALink-Mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "vocalinkmobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#00AEEF"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.lacsyy.VOCALinkMobile"
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b10a6c4c-c861-4098-90b7-58f1eb25ac2c"
      }
    },
    "owner": "lacsyy"
  }
}
